#!/usr/bin/env node
const fs = require('node:fs');
const os = require('node:os');
const path = require('node:path');
const { pathToFileURL } = require('node:url');
const { createHash } = require('node:crypto');
const { spawn } = require('node:child_process');

async function run(command, args, timeoutMs) {
  return new Promise((resolve, reject) => {
    const child = spawn(command, args, { detached: true, stdio: ['ignore', 'pipe', 'pipe'] });
    let output = '', timedOut = false, cancelled = false;
    const stop = () => { try { process.kill(-child.pid, 'SIGKILL'); } catch {} };
    const cancel = () => { cancelled = true; stop(); };
    process.once('SIGINT', cancel);
    process.once('SIGTERM', cancel);
    const timer = setTimeout(() => { timedOut = true; stop(); }, timeoutMs);
    const cleanup = () => {
      clearTimeout(timer);
      process.removeListener('SIGINT', cancel);
      process.removeListener('SIGTERM', cancel);
    };
    for (const stream of [child.stdout, child.stderr]) stream.on('data', chunk => { output = (output + chunk).slice(-32768); });
    child.on('error', error => { cleanup(); reject(error); });
    child.on('close', code => {
      cleanup();
      stop();
      if (cancelled || timedOut || code !== 0) reject(new Error(`${command}: ${cancelled ? 'cancelled' : timedOut ? 'deadline exceeded' : `exit ${code}`}\n${output}`));
      else resolve(output);
    });
  });
}

async function main() {
  const [sourceArg, outputArg] = process.argv.slice(2);
  if (!sourceArg || !outputArg || process.argv.length !== 4) throw new Error('Usage: design-export SOURCE.html NEW_OUTPUT_DIRECTORY');
  const source = fs.realpathSync(sourceArg), output = path.resolve(outputArg);
  if (!/\.html?$/i.test(source) || !fs.statSync(source).isFile()) throw new Error('Source must be a local HTML file.');
  if (fs.existsSync(output)) throw new Error('Output directory already exists; choose a new version.');
  fs.mkdirSync(output, { recursive: true, mode: 0o700 });
  const profile = fs.mkdtempSync(path.join(os.tmpdir(), 'omb-design-export-'));
  const pdf = path.join(output, 'document.pdf');
  try {
    await run('/opt/openmausbot-browser/chrome', [
      '--headless', '--no-sandbox', '--disable-gpu', '--disable-dev-shm-usage',
      '--disable-background-networking', '--no-first-run', '--no-default-browser-check',
      '--host-resolver-rules=MAP * ~NOTFOUND', `--user-data-dir=${profile}`,
      '--no-pdf-header-footer', '--print-to-pdf-no-header', '--timeout=20000',
      '--virtual-time-budget=5000', `--print-to-pdf=${pdf}`, pathToFileURL(source).href,
    ], 45000);
    const info = await run('pdfinfo', [pdf], 10000);
    const pages = Number(info.match(/^Pages:\s+(\d+)/m)?.[1]);
    if (!pages || pages > 20) throw new Error(`Expected 1–20 pages; found ${pages}.`);
    await run('pdftotext', ['-layout', pdf, path.join(output, 'text.txt')], 10000);
    await run('pdftoppm', ['-png', '-r', '120', pdf, path.join(output, 'page')], 45000);
    const previews = fs.readdirSync(output).filter(x => /^page-\d+\.png$/.test(x)).sort((a, b) => a.localeCompare(b, undefined, { numeric: true }));
    if (previews.length !== pages) throw new Error('PDF preview count does not match page count.');
    const receipt = { source, pdf, sha256: createHash('sha256').update(fs.readFileSync(pdf)).digest('hex'), pages, previews, status: 'exported_awaiting_visual_review', createdAt: new Date().toISOString() };
    fs.writeFileSync(path.join(output, 'export.json'), JSON.stringify(receipt, null, 2));
    console.log(JSON.stringify(receipt));
  } finally {
    fs.rmSync(profile, { recursive: true, force: true });
  }
}
main().catch(error => { console.error(error.message); process.exitCode = 1; });
